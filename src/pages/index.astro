---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      .post-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 24px;
      }
      
      /* Brighter, distinct color palette */
      .post-list li:nth-child(4n + 1) {
        --card-bg: #2c3e50; /* Muted Slate Blue */
        --card-hover: #34495e;
      }
      .post-list li:nth-child(4n + 2) {
        --card-bg: #2d4239; /* Muted Forest Green */
        --card-hover: #364f44;
      }
      .post-list li:nth-child(4n + 3) {
        --card-bg: #40304a; /* Muted Plum / Deep Purple */
        --card-hover: #4c3958;
      }
      .post-list li:nth-child(4n + 4) {
        --card-bg: #4a3530; /* Muted Rust / Warm Brown */
        --card-hover: #573e38;
      }

      .post-list li a {
        display: block;
        padding: 1.8em 2em;
        background: var(--card-bg, #1c1c1e);
        border-radius: 12px;
        text-decoration: none;
        transition: background 0.2s ease, transform 0.2s ease;
      }
      
      .post-list li a:hover {
        background: var(--card-hover, #242426);
        transform: translateY(-2px);
      }
      
      .post-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.4em;
        color: #f8f9fa; /* Brightened the title slightly for better contrast */
        margin: 0 0 0.3em 0;
        line-height: 1.3;
      }
      
      .post-description {
        font-size: 0.95em;
        color: #d1d5db; /* Brightened description text to stand out against new colors */
        margin: 0 0 0.6em 0;
        line-height: 1.5;
      }
      
      .post-date {
        font-size: 0.8em;
        color: #67e8f9; /* Brightened date text slightly */
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }
      
      .page-intro {
        margin-bottom: 2.5em;
      }
      
      .page-intro p {
        color: #8c8c8c;
        font-size: 0.95em;
        margin: 0;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="page-intro">
        <p>My writings on AI Communications and Fraud.</p>
      </div>
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>
              <h2 class="post-title">{post.data.title}</h2>
              {post.data.description && (
                <p class="post-description">{post.data.description}</p>
              )}
              <div class="post-date">
                <FormattedDate date={post.data.pubDate} />
              </div>
            </a>
          </li>
        ))}
      </ul>
    </main>
    <Footer />
  </body>
</html>
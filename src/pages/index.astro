---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const pinnedPosts = allPosts.filter(post => post.data.pinned);
const regularPosts = allPosts.filter(post => !post.data.pinned);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      .post-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 24px;
      }

      .post-list li:nth-child(4n + 1) {
        --card-bg: #2c3e50;
        --card-hover: #34495e;
      }
      .post-list li:nth-child(4n + 2) {
        --card-bg: #2d4239;
        --card-hover: #364f44;
      }
      .post-list li:nth-child(4n + 3) {
        --card-bg: #40304a;
        --card-hover: #4c3958;
      }
      .post-list li:nth-child(4n + 4) {
        --card-bg: #4a3530;
        --card-hover: #573e38;
      }

      .post-list li a {
        display: block;
        padding: 1.8em 2em;
        background: var(--card-bg, #1c1c1e);
        border-radius: 12px;
        text-decoration: none;
        transition: background 0.2s ease, transform 0.2s ease;
      }

      .post-list li a:hover {
        background: var(--card-hover, #242426);
        transform: translateY(-2px);
      }

      .post-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.4em;
        color: #f8f9fa;
        margin: 0 0 0.3em 0;
        line-height: 1.3;
      }

      .post-description {
        font-size: 0.95em;
        color: #d1d5db;
        margin: 0 0 0.6em 0;
        line-height: 1.5;
      }

      .post-date {
        font-size: 0.8em;
        color: #67e8f9;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      /* PINNED SECTION */
      .section-label {
        font-size: 11px;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #666;
        margin-bottom: 16px;
        margin-top: 8px;
      }

      .pinned-list {
        list-style: none;
        margin: 0 0 48px 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .pinned-list li a {
        display: block;
        padding: 1.8em 2em;
        background: #2a1f0e;
        border: 1px solid #c8730a;
        border-left: 4px solid #c8730a;
        border-radius: 12px;
        text-decoration: none;
        transition: background 0.2s ease, transform 0.2s ease;
      }

      .pinned-list li a:hover {
        background: #332510;
        transform: translateY(-2px);
      }

      .pinned-badge {
        font-size: 10px;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #c8730a;
        margin-bottom: 8px;
        display: block;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>

      {pinnedPosts.length > 0 && (
        <>
          <p class="section-label">Essential Reading</p>
          <ul class="pinned-list">
            {pinnedPosts.map((post) => (
              <li>
                <a href={`/blog/${post.id}/`}>
                  <span class="pinned-badge">📌 Pinned</span>
                  <h2 class="post-title">{post.data.title}</h2>
                  {post.data.description && (
                    <p class="post-description">{post.data.description}</p>
                  )}
                  <div class="post-date">
                    <FormattedDate date={post.data.pubDate} />
                  </div>
                </a>
              </li>
            ))}
          </ul>
          <p class="section-label">All Posts</p>
        </>
      )}

      <ul class="post-list">
        {regularPosts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>
              <h2 class="post-title">{post.data.title}</h2>
              {post.data.description && (
                <p class="post-description">{post.data.description}</p>
              )}
              <div class="post-date">
                <FormattedDate date={post.data.pubDate} />
              </div>
            </a>
          </li>
        ))}
      </ul>

    </main>
    <Footer />
  </body>
</html>